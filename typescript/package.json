{
  "name": "@utcp/strands",
  "version": "0.1.0",
  "description": "Use tools discovered by a UTCP client with the Strands Agents SDK",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/universal-tool-calling-protocol/strands-utcp.git",
